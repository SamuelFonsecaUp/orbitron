{
  "name": "orbitron",
  "version": "1.2.0",
  "description": "Orbitron - Sistema Operacional Pessoal Espacial 100% Local-First",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env NODE_ENV=development electron electron/main.cjs\"",
    "build": "vite build",
    "test": "vitest run",
    "start": "cross-env NODE_ENV=production electron electron/main.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "vite build && electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.orbitron.app",
    "productName": "Orbitron",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/assets/pigo-icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orbitron - Sistema Pessoal"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SamuelFonsecaUp",
        "repo": "pigo-financas"
      }
    ]
  },
  "keywords": [],
  "author": "Meu Financeiro",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  },
  "productName": "Orbitron"
}
